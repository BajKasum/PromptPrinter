# Version control
.git
.gitignore
.gitattributes

# Build / dependency artifacts (rebuilt inside the image)
node_modules
.next
out
build
dist
*.tsbuildinfo

# Environment — never bake real secrets into the image
.env
.env.local
.env.*.local
.env.docker
!.env.example
!.env.docker.example

# IDE / editor / OS
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Logs & caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo
.cache
coverage

# Design references (regenerate from Stitch MCP if needed)
.stitch-refs

# Docker meta (no point copying into the build context)
Dockerfile
.dockerignore
docker-compose*.yml

# Misc
README.md
LICENSE

# Nicht Teil des Images und nicht Eingabe von `next build`: ohne sie ändert eine reine Doku- oder Teständerung die
# Schicht `COPY . .` nicht und entwertet den Build-Cache nicht (#223). Der TypeScript-Schritt von `next build` liest
# aber alle *.ts im Projekt: src/**/*.test.tsx importiert `@tests/support/…` und playwright.config.ts
# `e2e/support/env`, diese beiden Ordner bleiben im Kontext.
.claude
.github
docs
supabase
scripts
screenshots_Docs
test-results
playwright-report
tests/*
!tests/support
e2e/*
!e2e/support
