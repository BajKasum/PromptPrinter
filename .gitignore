# Vercel CLI's local project-link artifact (`vercel link`/`vercel dev`),
# machine-specific, not needed by the Vercel platform itself (git-integrated
# deploys pick up the project from the dashboard link, not this folder).
.vercel

# Stitch design references — local only, regenerate from MCP if needed
.stitch-refs/

# Local agent config — never commit (keeps explicit staging from leaking it).
# Exception: .claude/skills/ is portable, shareable skill content (no secrets),
# committed on purpose so it travels with the repo.
.claude/*
!.claude/skills/

# Generated docs & screenshots — binaries, keep out of git history.
# Regenerate screenshots via scripts/take-screenshots.mjs.
screenshots/
screenshots_Docs/
*.docx

# scratch dir for mascot asset generation
.mascot-tmp/
