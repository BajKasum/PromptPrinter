# ─── Public / client-side ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile ("Bestätigen Sie, dass Sie ein Mensch sind" on
# login/signup/reset). SITE key only — it's public by design. The matching
# SECRET key never goes in this app: enter it in Supabase → Authentication →
# Attack Protection → CAPTCHA (provider: Turnstile); Supabase verifies the
# token server-side. Unset = widget hidden, forms work without captcha.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4...

# ─── Server-side only (NEVER prefix with NEXT_PUBLIC_) ────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI provider — Z.ai (GLM) powers /api/chat and /api/generate (see
# src/lib/llm.ts). Key from https://z.ai/manage-apikey/apikey-list.
# Without any provider key both endpoints answer in stub mode (the prompt
# templates come back unchanged), so the flow stays testable.
ZAI_API_KEY=...
# Optional — override the model (default: glm-5-turbo)
# ZAI_MODEL=glm-5-turbo

# Secondary provider — used only when ZAI_API_KEY is not set.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash

# BYOK — encrypts users' own Anthropic/OpenAI/Gemini keys (settings → "Eigene
# API-Keys") before they're stored (see src/lib/crypto.ts, migration 0015).
# Any long random string; changing it after keys exist makes them
# undecryptable, so treat it like any other production secret.
API_KEY_ENCRYPTION_SECRET=...

# Stripe billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...

# Notbremse gegen Kostenausreisser: Obergrenze an Modell-Aufrufen pro UTC-Tag,
# die auf dem SERVER-Key laufen (BYOK-Nutzer zaehlen nicht mit und laufen auch
# dann weiter, wenn das Budget erschoepft ist). Global, nicht pro Nutzer — das
# ist der Backstop fuer das naechste Leck, nicht eine weitere Nutzerquote.
# Grob 0,012 $ pro Aufruf im schlechtesten Fall, 1000 begrenzt einen schlechten
# Tag also auf rund 12 $. Default 1000, wenn nicht gesetzt. Braucht Upstash
# (siehe unten), ohne Redis ist die Bremse wirkungslos.
# LLM_DAILY_CALL_BUDGET=1000

# Rate limiting — Upstash Redis (recommended for prod). Without these two vars
# /api/generate falls back to an in-memory limiter (fine for local dev or a
# single instance, but not shared across serverless instances).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Screenshot script (scripts/take-screenshots.mjs) — credentials it logs in
# with via the normal form. Use your own account or a demo account; the script
# never mutates the password. Only needed locally to regenerate screenshots.
# SCREENSHOT_EMAIL=you@example.com
# SCREENSHOT_PASSWORD=your-password
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
