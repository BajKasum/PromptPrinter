      "--text-headline-lg-lh", "--text-headline-lg-ls", "--text-headline-lg-size", "--text-headline-lg-weight",
      "--text-headline-md-lh", "--text-headline-md-ls", "--text-headline-md-size", "--text-headline-md-weight",
      "--text-headline-sm-lh", "--text-headline-sm-ls", "--text-headline-sm-size", "--text-headline-sm-weight",
      "--text-label-caps-lh", "--text-label-caps-ls", "--text-label-caps-size", "--text-label-caps-weight",
      "--text-label-lh", "--text-label-size", "--text-label-weight",
      "--tier-team", "--tier-team-subtle", "--warning", "--warning-foreground"
    ],
    "tokenKinds": {
      "--background": "color", "--foreground": "color", "--surface": "color", "--surface-raised": "color",
      "--surface-hover": "color", "--border": "color", "--border-strong": "color", "--muted-foreground": "color",
      "--primary": "color", "--primary-foreground": "color", "--accent": "color", "--accent-foreground": "color",
      "--accent-text": "color", "--accent-subtle": "color", "--ring": "color", "--accent-warm": "color",
      "--destructive": "color", "--destructive-foreground": "color", "--success": "color", "--success-foreground": "color",
      "--warning": "color", "--warning-foreground": "color", "--shadow": "color", "--tier-team": "color",
      "--tier-team-subtle": "color", "--star-fav": "color",
      "--font-sans": "font", "--font-mono": "font",
      "--text-display-2xl-size": "font", "--text-display-2xl-lh": "font", "--text-display-2xl-ls": "font", "--text-display-2xl-weight": "font",
      "--text-display-xl-size": "font", "--text-display-xl-lh": "font", "--text-display-xl-ls": "font", "--text-display-xl-weight": "font",
      "--text-display-lg-size": "font", "--text-display-lg-lh": "font", "--text-display-lg-ls": "font", "--text-display-lg-weight": "font",
      "--text-display-md-size": "font", "--text-display-md-lh": "font", "--text-display-md-ls": "font", "--text-display-md-weight": "font",
      "--text-headline-lg-size": "font", "--text-headline-lg-lh": "font", "--text-headline-lg-ls": "font", "--text-headline-lg-weight": "font",
      "--text-headline-md-size": "font", "--text-headline-md-lh": "font", "--text-headline-md-ls": "font", "--text-headline-md-weight": "font",
      "--text-headline-sm-size": "font", "--text-headline-sm-lh": "font", "--text-headline-sm-ls": "font", "--text-headline-sm-weight": "font",
      "--text-body-lg-size": "font", "--text-body-lg-lh": "font", "--text-body-lg-weight": "font",
      "--text-body-md-size": "font", "--text-body-md-lh": "font", "--text-body-md-weight": "font",
      "--text-body-sm-size": "font", "--text-body-sm-lh": "font", "--text-body-sm-weight": "font",
