{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/floaters/**",
              "components/brand/logo/**",
              "components/brand/mascot/**",
              "components/brand/tool-logos/**",
              "components/core/badge/**",
              "components/core/button/**",
              "components/core/card/**",
              "components/core/icon/**",
              "components/core/input/**",
              "components/core/skeleton/**",
              "components/feedback/toast/**",
              "components/feedback/usage-meter/**",
              "components/navigation/menu-toggle-icon/**",
              "doc-page.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|asChild|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, asChild, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DolphinLoader'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|assetsBase|className|key|ref|className|style|children)$/]",
        "message": "<DolphinLoader> doesn't accept that prop. Declared props: size, label, assetsBase, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloaterSpec'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|top|left|size|delay|duration|key|ref|className|style|children)$/]",
        "message": "<FloaterSpec> doesn't accept that prop. Declared props: kind, top, left, size, delay, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloaterSpec'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:star|bubble)$/]",
        "message": "<FloaterSpec> kind must be one of 'star' | 'bubble'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|className|style|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, className, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|size|iconOnly|accentWordmark|collapsed|assetsBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: className, size, iconOnly, accentWordmark, collapsed, assetsBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mascot'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|state|src|assetsBase|priority|key|ref|className|style|children)$/]",
        "message": "<Mascot> doesn't accept that prop. Declared props: size, state, src, assetsBase, priority."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuToggleIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|duration|key|ref|className|style|children)$/]",
        "message": "<MenuToggleIcon> doesn't accept that prop. Declared props: open, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuccessCelebration'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|description|onDone|durationMs|assetsBase|className|key|ref|className|style|children)$/]",
        "message": "<SuccessCelebration> doesn't accept that prop. Declared props: message, description, onDone, durationMs, assetsBase, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToastInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|variant|key|ref|className|style|children)$/]",
        "message": "<ToastInput> doesn't accept that prop. Declared props: title, description, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolVisual'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|blurb|key|ref|className|style|children)$/]",
        "message": "<ToolVisual> doesn't accept that prop. Declared props: color, blurb."
      },
      {
        "selector": "JSXOpeningElement[name.name='UsageMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|used|limit|key|ref|className|style|children)$/]",
        "message": "<UsageMeter> doesn't accept that prop. Declared props: label, used, limit."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Badge": { "replaces": [] },
      "Button": { "replaces": [] },
      "Card": { "replaces": [] },
      "DolphinLoader": { "replaces": [] },
      "FloaterSpec": { "replaces": [] },
      "Icon": { "replaces": [] },
      "Input": { "replaces": [] },
      "Label": { "replaces": [] },
      "Logo": { "replaces": [] },
      "Mascot": { "replaces": [] },
      "MenuToggleIcon": { "replaces": [] },
      "PasswordInput": { "replaces": [] },
      "Skeleton": { "replaces": [] },
      "SuccessCelebration": { "replaces": [] },
      "ToastInput": { "replaces": [] },
      "ToolVisual": { "replaces": [] },
      "UsageMeter": { "replaces": [] }
    },
    "tokens": [
      "--accent", "--accent-foreground", "--accent-subtle", "--accent-text", "--accent-warm",
      "--background", "--border", "--border-strong", "--container-max",
      "--destructive", "--destructive-foreground",
      "--duration-entrance", "--duration-micro", "--ease-out-expo",
      "--font-mono", "--font-sans", "--foreground", "--gutter",
      "--muted-foreground", "--primary", "--primary-foreground",
      "--radius-2xl", "--radius-3xl", "--radius-full", "--radius-lg", "--radius-md", "--radius-sm", "--radius-xl",
      "--ring", "--shadow", "--shadow-card", "--shadow-elevated",
      "--space-1", "--space-10", "--space-12", "--space-16", "--space-2", "--space-20", "--space-24",
      "--space-3", "--space-32", "--space-4", "--space-5", "--space-6", "--space-8",
      "--star-fav", "--success", "--success-foreground", "--surface", "--surface-hover", "--surface-raised",
      "--text-body-lg-lh", "--text-body-lg-size", "--text-body-lg-weight",
      "--text-body-md-lh", "--text-body-md-size", "--text-body-md-weight",
      "--text-body-sm-lh", "--text-body-sm-size", "--text-body-sm-weight",
      "--text-code-lh", "--text-code-size", "--text-code-weight",
      "--text-display-2xl-lh", "--text-display-2xl-ls", "--text-display-2xl-size", "--text-display-2xl-weight",
