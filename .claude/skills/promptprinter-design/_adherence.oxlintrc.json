      "--shadow-card": "shadow", "--shadow-elevated": "shadow",
      "--ease-out-expo": "other", "--duration-micro": "other", "--duration-entrance": "other"
    },
    "fontFamilies": ["Geist", "Geist Mono"]
  }
}
