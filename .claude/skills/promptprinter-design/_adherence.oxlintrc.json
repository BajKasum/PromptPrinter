      "--space-1": "spacing", "--space-2": "spacing", "--space-3": "spacing", "--space-4": "spacing",
      "--space-5": "spacing", "--space-6": "spacing", "--space-8": "spacing", "--space-10": "spacing",
      "--space-12": "spacing", "--space-16": "spacing", "--space-20": "spacing", "--space-24": "spacing", "--space-32": "spacing",
      "--container-max": "spacing", "--gutter": "spacing",
      "--radius-sm": "radius", "--radius-md": "radius", "--radius-lg": "radius", "--radius-xl": "radius",
